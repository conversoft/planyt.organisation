{
  "name": "conversoft/planyt-organisation",
  "description": "Personal work overview connecting Trello, Gmail and Google Calendar.",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Planyt\\Organisation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Planyt\\Organisation\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "test": "phpunit --configuration phpunit.xml.dist",
    "quality": [
      "@lint",
      "@test"
    ]
  }
}
