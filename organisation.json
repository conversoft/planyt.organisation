{
  "schemaVersion": 1,
  "application": {
    "name": "Planyt Organisation",
    "repository": "conversoft/planyt.organisation",
    "status": "prototype",
    "version": "0.1.0-dev",
    "branchPolicy": "main-only"
  },
  "platform": {
    "php": "8.4",
    "portableState": "json",
    "technicalMetadata": "sqlite-optional",
    "javascript": "native-first",
    "configuration": "zero-env-runtime"
  },
  "integrations": {
    "trello": {
      "mode": "read-only",
      "auth": "oauth2-confidential-pkce",
      "scopes": [
        "read:member:trello",
        "read:board:trello",
        "offline_access"
      ]
    },
    "gmail": {
      "mode": "read-only",
      "auth": "existing-google-login",
      "scopes": [
        "https://www.googleapis.com/auth/gmail.readonly"
      ],
      "outboundCommunication": false
    },
    "googleDrive": {
      "mode": "read-only",
      "auth": "existing-google-login",
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly"
      ]
    },
    "googleCalendar": {
      "mode": "read-write-owned",
      "auth": "existing-google-login",
      "scopes": [
        "https://www.googleapis.com/auth/calendar.events.owned"
      ],
      "requiresExplicitUserAction": true
    },
    "proad": {
      "mode": "capability-gated-read-write",
      "auth": "per-user-api-key",
      "requiresExplicitUserAction": true,
      "capabilities": [
        "read_projects",
        "book_time",
        "create_project",
        "create_contact",
        "create_offer"
      ],
      "offerCreation": "disabled-until-endpoint-verified"
    }
  },
  "promptCompiler": {
    "externalAiApi": false,
    "delivery": "clipboard",
    "maySendCommunication": false
  },
  "update": {
    "branch": "main",
    "strategy": "fast-forward-only"
  },
  "storage": {
    "tokens": "per-user-encrypted-tokens.json",
    "userState": "json",
    "technicalMetadata": "sqlite-optional",
    "installationConfig": "storage/system/config.json"
  }
}
