{
  "schemaVersion": 1,
  "application": {
    "name": "Planyt Organisation",
    "repository": "conversoft/planyt.organisation",
    "status": "prototype",
    "version": "0.1.0-dev",
    "branchPolicy": "main-only"
  },
  "platform": {
    "php": "8.4",
    "portableState": "json",
    "technicalMetadata": "sqlite-optional",
    "javascript": "native-first"
  },
  "integrations": {
    "trello": {"mode": "read-only"},
    "gmail": {"mode": "read-only", "outboundCommunication": false},
    "googleDrive": {"mode": "read-only"},
    "googleCalendar": {"mode": "read-write", "requiresExplicitUserAction": true}
  },
  "promptCompiler": {
    "externalAiApi": false,
    "delivery": "clipboard",
    "maySendCommunication": false
  },
  "update": {
    "branch": "main",
    "strategy": "fast-forward-only"
  }
}
