<?xml version="1.0"?>
<ruleset name="Planyt Organisation">
    <description>PSR-12 coding standard for Planyt Organisation.</description>
    <arg name="warning-severity" value="0"/>
    <rule ref="PSR12"/>
    <file>src</file>
    <file>public</file>
    <file>bin</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>public/index.php</exclude-pattern>
</ruleset>
